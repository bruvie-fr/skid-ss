})

register({
	id = "ui_log", category = "Interface", kind = "statement", side = "client",
	label = "log %text to console",
	inputs = { { name = "text", default = Defs.lit("hi", "string") } },
	exec = function(node, ctx, state) state.api.log(tostring(ctx.eval(node.inputs.text))) end,
	toLua = function(node, c) return c.pad .. "ui.log(" .. c.in_("text") .. ")" end,
})

register({
	id = "ui_add_button", category = "Interface", kind = "statement", side = "client",
	label = "add quick button %label",
	inputs = { { name = "label", default = Defs.lit("Run", "string") } },
	exec = function(node, ctx, state) state.api.addButton(tostring(ctx.eval(node.inputs.label))) end,
	toLua = function(node, c) return c.pad .. "ui.addButton(" .. c.in_("label") .. ")" end,
})

return Defs
end)()

local SkidSS_BlocksInterpreter = (function()
local Defs = SkidSS_BlocksDefs

local Interpreter = {}

function Interpreter.run(program, api, config, allow)
	assert(type(program) == "table", "program must be a table")

	local state = {
		vars = {},
		api = api,
		config = config,
		allow = allow or { server = true, client = true, both = true },
		steps = 0,
	}

	local ctx = {}

	function ctx.tick()
		state.steps += 1
		if state.steps > config.Limits.MaxSteps then
			error("step limit reached (" .. config.Limits.MaxSteps .. ")", 0)
		end
	end

	local function check(node, want)
		local def = Defs.byId[node and node.type]
		if not def or not def[want] then
			error("expected a " .. want .. " block, got " .. tostring(node and node.type), 0)
		end
		if not state.allow[def.side] then
			error("block '" .. def.id .. "' is not allowed here", 0)
		end
		return def
	end

	function ctx.eval(node)
		ctx.tick()
		return check(node, "eval").eval(node, ctx, state)
	end

	function ctx.exec(node)
		ctx.tick()
		check(node, "exec").exec(node, ctx, state)
	end

	function ctx.execBody(node, name)
		local body = node.bodies and node.bodies[name]
		if not body then return end
		for _, child in body do
			ctx.exec(child)
		end
	end

	for _, node in program do
		ctx.exec(node)
	end

	return state
end

return Interpreter
end)()

local SkidSS_BlocksLua = (function()
local Defs = SkidSS_BlocksDefs

local Lua = {}

local function q(text)
	return string.format("%q", tostring(text))
end

local function compileValue(node)
	if type(node) ~= "table" then return "nil" end
	local def = Defs.byId[node.type]
	if not def or not def.toLua then return "nil" end
	return def.toLua(node, {
		q = q,
		in_ = function(name) return compileValue(node.inputs and node.inputs[name]) end,
		field = function(name) return node.fields and node.fields[name] end,
	})
end

local function compileNode(node, indent)
	local def = Defs.byId[node.type]
	if not def or not def.toLua then
		return string.rep("\t", indent) .. "-- unknown block"
	end
	return def.toLua(node, {
		q = q,
		pad = string.rep("\t", indent),
		in_ = function(name) return compileValue(node.inputs and node.inputs[name]) end,
		field = function(name) return node.fields and node.fields[name] end,
		body = function(name)
			local lines = {}
			local body = node.bodies and node.bodies[name]
			if body then
				for _, child in body do
					table.insert(lines, compileNode(child, indent + 1))
				end
			end
			return table.concat(lines, "\n")
		end,
	})
end

local PREAMBLE = table.concat({
	'local Players = game:GetService("Players")',
	"local _vars = {}",
	"local function _findPlayer(name)",
	"\tfor _, p in Players:GetPlayers() do",
	"\t\tif string.lower(p.Name) == string.lower(name) then return p end",
	"\tend",
	"\treturn nil",
	"end",
	"",
}, "\n")

function Lua.compile(program)
	local lines = {}
	for _, node in program do
		table.insert(lines, compileNode(node, 0))
	end
	return PREAMBLE .. "\n" .. table.concat(lines, "\n")
end

return Lua
end)()

if SETTINGS then
	SkidSS_Config.Limits.MaxSteps = SETTINGS.maxSteps or SkidSS_Config.Limits.MaxSteps
	SkidSS_Config.Limits.MaxLoopIterations = SETTINGS.maxLoopIterations or SkidSS_Config.Limits.MaxLoopIterations
	SkidSS_Config.Limits.MaxWaitSeconds = SETTINGS.maxWaitSeconds or SkidSS_Config.Limits.MaxWaitSeconds
end

-- ===== END SHARED MODULES =====

if RunService:IsClient() then
-- ===== CLIENT (runs in the cloned script inside PlayerGui) =====
local SkidSS_Client_Theme = (function()
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = SkidSS_Config

local Theme = {}

Theme.colors = {
	accent = Config.UI.Accent,
	background = Config.UI.Background,
	panel = Config.UI.Panel,
	panelAlt = Config.UI.PanelAlt,
	text = Config.UI.Text,
	subText = Config.UI.SubText,
	good = Config.UI.Good,
	bad = Config.UI.Bad,
}

function Theme.create(className, props, children)
	local instance = Instance.new(className)
	if props then
		for key, value in props do
			if key ~= "Parent" then
				instance[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if props and props.Parent then
		instance.Parent = props.Parent
	end
	return instance
end

function Theme.corner(radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 6)
	return corner
end

function Theme.padding(amount)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, amount)
	pad.PaddingRight = UDim.new(0, amount)
	pad.PaddingTop = UDim.new(0, amount)
	pad.PaddingBottom = UDim.new(0, amount)
	return pad
end

function Theme.listLayout(padding, direction)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = direction or Enum.FillDirection.Vertical
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padding or 4)
	return layout
end

return Theme
end)()

local SkidSS_Client_Palette = (function()
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Defs = SkidSS_BlocksDefs
local Theme = SkidSS_Client_Theme

local Palette = {}

local function preview(label)
	return (string.gsub(label or "", "%%(%S+)", "[%1]"))
end

function Palette.build(parent, allow, onPick)
	Theme.listLayout(4).Parent = parent
	local order = 0

	for _, category in Defs.categoryOrder do
		local defs = {}
		for _, def in Defs.categories[category] do
			if def.kind == "statement" and not def.hidden and allow[def.side] then
				table.insert(defs, def)
			end
		end

		if #defs > 0 then
			order += 1
			Theme.create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 18),
				BackgroundTransparency = 1,
				Text = category,
				TextColor3 = Theme.colors.subText,
				Font = Enum.Font.GothamBold,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = order,
				Parent = parent,
			})

			for _, def in defs do
				order += 1
				local button = Theme.create("TextButton", {
					Size = UDim2.new(1, 0, 0, 26),
					BackgroundColor3 = Theme.colors.panelAlt,
					Text = " " .. preview(def.label),
					TextColor3 = Theme.colors.text,
					Font = Enum.Font.Gotham,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					LayoutOrder = order,
					Parent = parent,
				}, { Theme.corner(4) })
				button.MouseButton1Click:Connect(function()
					onPick(def.id)
				end)
			end
		end
	end
end

return Palette
end)()

local SkidSS_Client_BlockCanvas = (function()
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Defs = SkidSS_BlocksDefs
local Theme = SkidSS_Client_Theme

local BlockCanvas = {}

local CATEGORY_COLORS = {
	Output = Color3.fromRGB(74, 110, 190),
	Control = Color3.fromRGB(206, 146, 56),
	Variables = Color3.fromRGB(196, 104, 66),
	Operators = Color3.fromRGB(86, 166, 106),
	Players = Color3.fromRGB(146, 96, 196),
	Interface = Color3.fromRGB(66, 156, 166),
	Values = Color3.fromRGB(108, 108, 128),
}

local function categoryColor(category)
	return CATEGORY_COLORS[category] or Color3.fromRGB(90, 90, 110)
end

local function parseLabel(label)
	local tokens = {}
	for word in string.gmatch(label or "", "%S+") do
		if string.sub(word, 1, 1) == "%" then
			table.insert(tokens, { slot = string.sub(word, 2) })
		else
			table.insert(tokens, { text = word })
		end
	end
	return tokens
end

local function fieldDef(def, name)
	if def.fields then
		for _, field in def.fields do
			if field.name == name then
				return field
			end
		end
	end
	return nil
end

local function textEditor(width, get, set)
	local box = Theme.create("TextBox", {
		Size = UDim2.fromOffset(width, 22),
		BackgroundColor3 = Theme.colors.panelAlt,
		TextColor3 = Theme.colors.text,
		Font = Enum.Font.Code,
		TextSize = 13,
		Text = get(),
		ClearTextOnFocus = false,
	}, { Theme.corner(4) })
	box.FocusLost:Connect(function()
		set(box.Text)
	end)
	return box
end

local function slotEditor(node, def, name)
	local input = node.inputs and node.inputs[name]
	if input then
		if input.type == "_literal" then
			local fields = input.fields
			if fields.vtype == "boolean" then
				local toggle = Theme.create("TextButton", {
					Size = UDim2.fromOffset(56, 22),
					BackgroundColor3 = Theme.colors.panelAlt,
					Text = tostring(fields.value),
					TextColor3 = Theme.colors.text,
					Font = Enum.Font.Code,
					TextSize = 13,
				}, { Theme.corner(4) })
				toggle.MouseButton1Click:Connect(function()
					fields.value = not (fields.value == true or fields.value == "true")
					toggle.Text = tostring(fields.value)
				end)
				return toggle
			end
			local width = fields.vtype == "number" and 56 or 110
			return textEditor(width, function() return tostring(fields.value) end, function(text) fields.value = text end)
		end
		return Theme.create("TextLabel", {
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 22),
			BackgroundTransparency = 1,
			Text = "(expr)",
			TextColor3 = Theme.colors.subText,
			Font = Enum.Font.Code,
			TextSize = 13,
		})
	end

	local field = fieldDef(def, name)
	if field then
		if field.kind == "choice" then
			local button = Theme.create("TextButton", {
				Size = UDim2.fromOffset(54, 22),
				BackgroundColor3 = Theme.colors.panelAlt,
				Text = tostring(node.fields[name]),
				TextColor3 = Theme.colors.accent,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
			}, { Theme.corner(4) })
			button.MouseButton1Click:Connect(function()
				local index = table.find(field.choices, node.fields[name]) or 1
				node.fields[name] = field.choices[(index % #field.choices) + 1]
				button.Text = tostring(node.fields[name])
			end)
			return button
		end
		return textEditor(90, function() return tostring(node.fields[name]) end, function(text) node.fields[name] = text end)
	end

	return nil
end

function BlockCanvas.new(parent, program, allow)
	local controller = {}
	local selection = { list = program, index = #program }

	Theme.listLayout(6).Parent = parent

	local function selectButton(list, index, isAppend)
		return selection.list == list and (isAppend and selection.index >= #list or selection.index == index)
	end

	local function insertButton(list)
		local button = Theme.create("TextButton", {
			Size = UDim2.new(1, 0, 0, 20),
			BackgroundColor3 = Theme.colors.panel,
			Text = "+ insert here",
			TextColor3 = Theme.colors.subText,
			Font = Enum.Font.Gotham,
			TextSize = 12,
		}, { Theme.corner(4) })
		if selectButton(list, #list, true) then
			local stroke = Instance.new("UIStroke")
			stroke.Color = Theme.colors.accent
			stroke.Parent = button
		end
		button.MouseButton1Click:Connect(function()
			selection = { list = list, index = #list }
			controller.refresh()
		end)
		return button
	end

	local function header(node, def, list, index)
		local frame = Theme.create("TextButton", {
			Size = UDim2.new(1, 0, 0, 30),
			BackgroundColor3 = categoryColor(def.category),
			Text = "",
			AutoButtonColor = false,
			BorderSizePixel = 0,
		}, { Theme.corner(6) })

		if selectButton(list, index, false) then
			local stroke = Instance.new("UIStroke")
			stroke.Color = Theme.colors.text
			stroke.Thickness = 2
			stroke.Parent = frame
		end
		frame.MouseButton1Click:Connect(function()
			selection = { list = list, index = index }
			controller.refresh()
		end)

		local left = Theme.create("Frame", {
			Size = UDim2.new(1, -104, 1, 0),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Parent = frame,
		}, { Theme.padding(6) })
		local row = Theme.listLayout(6, Enum.FillDirection.Horizontal)
		row.VerticalAlignment = Enum.VerticalAlignment.Center
		row.Parent = left

		local order = 0
		for _, token in parseLabel(def.label) do
			order += 1
			local element
			if token.slot then
				element = slotEditor(node, def, token.slot)
			end
			if not element then
				element = Theme.create("TextLabel", {
					AutomaticSize = Enum.AutomaticSize.X,
					Size = UDim2.fromOffset(0, 22),
					BackgroundTransparency = 1,
					Text = token.text or token.slot or "",
					TextColor3 = Theme.colors.text,
					Font = Enum.Font.GothamMedium,
					TextSize = 13,
				})
			end
			element.LayoutOrder = order
			element.Parent = left
		end

		local controls = Theme.create("Frame", {
			Size = UDim2.fromOffset(96, 30),
			Position = UDim2.new(1, -96, 0, 0),
			BackgroundTransparency = 1,
			Parent = frame,
		})
		local controlsRow = Theme.listLayout(4, Enum.FillDirection.Horizontal)
		controlsRow.HorizontalAlignment = Enum.HorizontalAlignment.Right
		controlsRow.VerticalAlignment = Enum.VerticalAlignment.Center
		controlsRow.Parent = controls

		local function control(symbol, onClick)
			local button = Theme.create("TextButton", {
				Size = UDim2.fromOffset(26, 22),
				BackgroundColor3 = Theme.colors.panelAlt,
				Text = symbol,
				TextColor3 = Theme.colors.text,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				Parent = controls,
			}, { Theme.corner(4) })
			button.MouseButton1Click:Connect(onClick)
		end

		control("\u{2191}", function()
			if index > 1 then
				list[index], list[index - 1] = list[index - 1], list[index]
				controller.refresh()
			end
		end)
		control("\u{2193}", function()
			if index < #list then
				list[index], list[index + 1] = list[index + 1], list[index]
				controller.refresh()
			end
		end)
		control("\u{2715}", function()
			table.remove(list, index)
			selection = { list = program, index = #program }
			controller.refresh()
		end)

		return frame
	end

	local function renderBlock(node, list, index, parent)
		local def = Defs.byId[node.type]
		if not def then return end

		local container = Theme.create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundTransparency = 1,
			LayoutOrder = index,
			Parent = parent,
		})
		Theme.listLayout(4).Parent = container

		local head = header(node, def, list, index)
		head.LayoutOrder = 0
		head.Parent = container

		if def.bodies then
			local bodyOrder = 0
			for _, bodyName in def.bodies do
				bodyOrder += 1
				local bodyBox = Theme.create("Frame", {
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					BackgroundColor3 = Theme.colors.background,
					BorderSizePixel = 0,
					LayoutOrder = bodyOrder,
					Parent = container,
				}, { Theme.corner(6) })
				local pad = Instance.new("UIPadding")
				pad.PaddingLeft = UDim.new(0, 16)
				pad.PaddingTop = UDim.new(0, 4)
				pad.PaddingBottom = UDim.new(0, 4)
				pad.PaddingRight = UDim.new(0, 4)
				pad.Parent = bodyBox
				Theme.listLayout(4).Parent = bodyBox

				local caption = Theme.create("TextLabel", {
					Size = UDim2.new(1, 0, 0, 16),
					BackgroundTransparency = 1,
					Text = bodyName,
					TextColor3 = Theme.colors.subText,
					Font = Enum.Font.Gotham,
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = 0,
					Parent = bodyBox,
				})

				local body = node.bodies[bodyName]
				for childIndex, child in body do
					renderBlock(child, body, childIndex, bodyBox)
				end

				local add = insertButton(body)
				add.LayoutOrder = 1e6
				add.Parent = bodyBox
			end
		end
	end

	function controller.refresh()
		for _, child in parent:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		for index, node in program do
			renderBlock(node, program, index, parent)
		end
		local tail = insertButton(program)
		tail.LayoutOrder = 1e6
		tail.Parent = parent
	end

	function controller.insert(defId)
		local list = selection.list or program
		local at = (selection.index or #list) + 1
		table.insert(list, at, Defs.instantiate(defId))
		selection = { list = list, index = at }
		controller.refresh()
	end

	controller.refresh()
	return controller
end

return BlockCanvas
end)()

local SkidSS_Client_BlockTab = (function()
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lua = SkidSS_BlocksLua
local Theme = SkidSS_Client_Theme
local Palette = SkidSS_Client_Palette
local BlockCanvas = SkidSS_Client_BlockCanvas

local BlockTab = {}

function BlockTab.build(parent, ctx, opts)
	local program = {}

	local frame = Theme.create("Frame", {
		Name = opts.name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = parent,
	})

	local paletteFrame = Theme.create("ScrollingFrame", {
		Size = UDim2.new(0, 184, 1, -44),
		BackgroundColor3 = Theme.colors.panel,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = frame,
	}, { Theme.corner(8), Theme.padding(6) })

	local canvasFrame = Theme.create("ScrollingFrame", {
		Size = UDim2.new(1, -192, 1, -44),
		Position = UDim2.fromOffset(192, 0),
		BackgroundColor3 = Theme.colors.panel,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = frame,
	}, { Theme.corner(8), Theme.padding(8) })

	local canvas = BlockCanvas.new(canvasFrame, program, opts.allow)
	Palette.build(paletteFrame, opts.allow, function(defId)
		canvas.insert(defId)
	end)

	local run = Theme.create("TextButton", {
		Size = UDim2.fromOffset(140, 32),
		Position = UDim2.new(1, -140, 1, -34),
		BackgroundColor3 = Theme.colors.accent,
		Text = opts.runText or "Run",
		TextColor3 = Theme.colors.text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		Parent = frame,
	}, { Theme.corner(8) })
	run.MouseButton1Click:Connect(function()
		opts.onRun(program)
	end)

	local view = Theme.create("TextButton", {
		Size = UDim2.fromOffset(110, 32),
		Position = UDim2.new(1, -260, 1, -34),
		BackgroundColor3 = Theme.colors.panelAlt,
		Text = "View Lua",
		TextColor3 = Theme.colors.text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		Parent = frame,
	}, { Theme.corner(8) })
	view.MouseButton1Click:Connect(function()
		for line in string.gmatch(Lua.compile(program), "[^\n]+") do
			ctx.log(line)
		end
	end)

	return { frame = frame, program = program }
end

return BlockTab
end)()

local SkidSS_Client_CodeTab = (function()
local Theme = SkidSS_Client_Theme

local CodeTab = {}

local SAMPLE = 'print("hello from the server")\n\nfor _, p in game:GetService("Players"):GetPlayers() do\n\tprint(p.Name)\nend'

function CodeTab.build(parent, ctx)
	local frame = Theme.create("Frame", {
		Name = "CodeTab",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = parent,
	})

	local holder = Theme.create("Frame", {
		Size = UDim2.new(1, 0, 1, -44),
		BackgroundColor3 = Theme.colors.panel,
		BorderSizePixel = 0,
		Parent = frame,
	}, { Theme.corner(8), Theme.padding(8) })

	local box = Theme.create("TextBox", {
		Name = "Source",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		TextColor3 = Theme.colors.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Font = Enum.Font.Code,
		TextSize = 15,
		MultiLine = true,
		ClearTextOnFocus = false,
		TextWrapped = false,
		Text = SAMPLE,
		Parent = holder,
	})

	local run = Theme.create("TextButton", {
		Size = UDim2.fromOffset(140, 32),
		Position = UDim2.new(1, -140, 1, -34),
		BackgroundColor3 = Theme.colors.accent,
		Text = "Run on server",
		TextColor3 = Theme.colors.text,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		Parent = frame,
	}, { Theme.corner(8) })

	run.MouseButton1Click:Connect(function()
		ctx.log("> running lua\u{2026}")
		ctx.execute({ mode = "lua", source = box.Text })
	end)

	return { frame = frame }
end

return CodeTab
end)()

local SkidSS_Client_Window = (function()
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("SkidSS")
local Config = SkidSS_Config
local Net = SkidSS_Net
local Interpreter = SkidSS_BlocksInterpreter

local Theme = SkidSS_Client_Theme
local CodeTab = SkidSS_Client_CodeTab
local BlockTab = SkidSS_Client_BlockTab

local Window = {}

local function normalizeAsset(value)
	value = tostring(value or "")
	if value == "" then return "" end
	if string.match(value, "^%d+$") then return "rbxassetid://" .. value end
	return value
end

local function buildElement(el, parent, env)
	local class = el.type == "image" and "ImageLabel"
		or el.type == "button" and "TextButton"
		or el.type == "label" and "TextLabel"
		or el.type == "codebox" and "TextBox"
		or el.type == "output" and "ScrollingFrame"
		or "Frame"

	local inst = Instance.new(class)
	inst.Position = UDim2.fromScale(tonumber(el.x) or 0, tonumber(el.y) or 0)
	inst.Size = UDim2.fromScale(tonumber(el.w) or 0.1, tonumber(el.h) or 0.1)
	inst.BorderSizePixel = 0
	inst.BackgroundColor3 = typeof(el.bg) == "Color3" and el.bg or Color3.fromRGB(28, 28, 36)
	inst.BackgroundTransparency = tonumber(el.bgTransparency) or (class == "ImageLabel" and 1 or 0)

	if tonumber(el.corner) and tonumber(el.corner) > 0 then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, tonumber(el.corner))
		corner.Parent = inst
	end

	if tonumber(el.borderThickness) and tonumber(el.borderThickness) > 0 then
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = tonumber(el.borderThickness)
		stroke.Color = typeof(el.borderColor) == "Color3" and el.borderColor or Color3.fromRGB(255, 255, 255)
		stroke.Parent = inst
	end

	if class == "ImageLabel" then
		inst.Image = normalizeAsset(el.image)
		if typeof(el.imageColor) == "Color3" then inst.ImageColor3 = el.imageColor end

		local id = string.match(tostring(el.image or ""), "%d+")
		if id then
			task.spawn(function()
				task.wait(2)
				if inst.Parent and not inst.IsLoaded then
					inst.Image = "rbxthumb://type=Asset&id=" .. id .. "&w=420&h=420"
				end
			end)
		end
	end

	if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
		inst.Text = tostring(el.text or "")
		inst.TextColor3 = typeof(el.textColor) == "Color3" and el.textColor or Color3.fromRGB(255, 255, 255)
		inst.TextSize = tonumber(el.textSize) or 16
		inst.Font = class == "TextBox" and Enum.Font.Code or Enum.Font.GothamMedium
	end

	if class == "TextBox" then
		inst.ClearTextOnFocus = false
		inst.MultiLine = true
		inst.TextWrapped = true
		inst.TextXAlignment = Enum.TextXAlignment.Left
		inst.TextYAlignment = Enum.TextYAlignment.Top
		if env and env.codeBoxes then
			env.codeBoxes[el.name or "main"] = inst
		end
	end

	if class == "ScrollingFrame" then
		inst.ScrollBarThickness = 4
		inst.CanvasSize = UDim2.new()
		inst.AutomaticCanvasSize = Enum.AutomaticSize.Y
		local layout = Instance.new("UIListLayout")
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Padding = UDim.new(0, 2)
		layout.Parent = inst
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 6)
		pad.PaddingTop = UDim.new(0, 4)
		pad.PaddingRight = UDim.new(0, 6)
		pad.PaddingBottom = UDim.new(0, 4)
		pad.Parent = inst
		local outColor = typeof(el.textColor) == "Color3" and el.textColor or Color3.fromRGB(212, 212, 226)
		local outSize = tonumber(el.textSize) or 13
		local order = 0
		local function append(line)
			order += 1
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.new(1, 0, 0, 0)
			lbl.AutomaticSize = Enum.AutomaticSize.Y
			lbl.BackgroundTransparency = 1
			lbl.Text = tostring(line)
			lbl.TextColor3 = outColor
			lbl.Font = Enum.Font.Code
			lbl.TextSize = outSize
			lbl.TextXAlignment = Enum.TextXAlignment.Left
			lbl.TextWrapped = true
			lbl.LayoutOrder = order
			lbl.Parent = inst
			task.defer(function()
				inst.CanvasPosition = Vector2.new(0, inst.AbsoluteCanvasSize.Y)
			end)
		end
		if env and env.outputs then
			table.insert(env.outputs, append)
		end
	end

	if class == "TextButton" then
		inst.AutoButtonColor = true
		if el.action and env and env.fireAction then
			inst.MouseButton1Click:Connect(function() env.fireAction(el.action) end)
		elseif el.execute and env then
			inst.MouseButton1Click:Connect(function()
				local box = env.codeBoxes and env.codeBoxes[el.execute]

				if not box and env.codeBoxes then
					local only, count = nil, 0
					for _, b in env.codeBoxes do only = b; count += 1 end
					if count == 1 then box = only end
				end
				if box then
					env.runCode(box.Text)
				elseif env.notify then
					env.notify("no code box to run")
				end
			end)
		end
	end

	if el.draggable then
		inst.Active = true
		local dragging, dragStart, startPositions
		inst.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPositions = {}
				if env and env.elementInsts then
					for _, other in env.elementInsts do
						startPositions[other] = other.Position
					end
				end
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then dragging = false end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				local cam = workspace.CurrentCamera
				local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
				local dx, dy = delta.X / vp.X, delta.Y / vp.Y
				for other, startPos in startPositions do
					other.Position = UDim2.new(startPos.X.Scale + dx, startPos.X.Offset, startPos.Y.Scale + dy, startPos.Y.Offset)
				end
			end
		end)
	end

	inst.Parent = parent
	return inst
end

function Window.mount(cfg)
	cfg = cfg or {}

	if typeof(cfg.accent) == "Color3" then Theme.colors.accent = cfg.accent end
	if typeof(cfg.background) == "Color3" then Theme.colors.background = cfg.background end
	if typeof(cfg.panel) == "Color3" then Theme.colors.panel = cfg.panel end
	if typeof(cfg.panelAlt) == "Color3" then Theme.colors.panelAlt = cfg.panelAlt end
	if typeof(cfg.text) == "Color3" then Theme.colors.text = cfg.text end

	local toggleKey = Config.UI.ToggleKey
	if type(cfg.toggleKey) == "string" then
		local ok, key = pcall(function() return Enum.KeyCode[cfg.toggleKey] end)
		if ok and key then toggleKey = key end
	end

	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	if playerGui:FindFirstChild("SkidSS") then return end

	local executeRemote = Net.get(Net.Execute)
	local outputRemote = Net.get(Net.Output)

	local gui = Instance.new("ScreenGui")
	gui.Name = "SkidSS"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	local useCustom = type(cfg.elements) == "table" and #cfg.elements > 0

	local lineOrder = 0
	local quickButtons = {}
	local hudOutputs = {}
	local console, titleLabel, accentStrip, root, quickBar
	local api = {}

	function api.notify(text)
		local toast = Theme.create("TextLabel", {
			Size = UDim2.fromOffset(280, 34),
			Position = UDim2.new(0.5, -140, 0, 50),
			BackgroundColor3 = Theme.colors.panelAlt,
			Text = tostring(text),
			TextColor3 = Theme.colors.text,
			Font = Enum.Font.GothamMedium,
			TextSize = 14,
			Parent = gui,
		}, { Theme.corner(8) })
		task.delay(2.5, function()
			toast:Destroy()
		end)
	end

	function api.log(text)
		text = tostring(text)
		for _, append in hudOutputs do
			append(text)
		end
		if console then
			lineOrder += 1
			Theme.create("TextLabel", {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				BackgroundTransparency = 1,
				Text = text,
				TextColor3 = Theme.colors.text,
				Font = Enum.Font.Code,
				TextSize = 13,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextWrapped = true,
				LayoutOrder = lineOrder,
				Parent = console,
			})
			task.defer(function()
				console.CanvasPosition = Vector2.new(0, console.AbsoluteCanvasSize.Y)
			end)
		elseif #hudOutputs == 0 then

			api.notify(text)
		end
	end

	function api.setTitle(text)
		if titleLabel then titleLabel.Text = text end
	end

	function api.setAccent(color)
		Theme.colors.accent = color
		if accentStrip then accentStrip.BackgroundColor3 = color end
		for _, button in quickButtons do
			button.BackgroundColor3 = color
		end
	end

	function api.setBackground(color)
		Theme.colors.background = color
		if root then root.BackgroundColor3 = color end
	end

	local state = { serverProgram = nil }
	local ctx = {
		log = api.log,
		execute = function(payload)
			executeRemote:FireServer(payload)
		end,
		state = state,
		window = api,
	}

	function api.addButton(label, onClick)
		if not quickBar then return end
		local button = Theme.create("TextButton", {
			Size = UDim2.fromOffset(110, 30),
			BackgroundColor3 = Theme.colors.accent,
			Text = label,
			TextColor3 = Theme.colors.text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			Parent = quickBar,
		}, { Theme.corner(6) })
		table.insert(quickButtons, button)
		button.MouseButton1Click:Connect(function()
			if onClick then
				onClick()
			elseif state.serverProgram then
				ctx.execute({ mode = "blocks", program = state.serverProgram })
				api.log("> running blocks\u{2026}")
			end
		end)
	end

	if useCustom then

		local hud = Theme.create("Frame", {
			Name = "HUD",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.colors.background,

			BackgroundTransparency = tonumber(cfg.backgroundTransparency) or 1,
			BorderSizePixel = 0,
			Parent = gui,
		})

		local elementInsts = {}
		local env = {
			codeBoxes = {},
			outputs = hudOutputs,
			elementInsts = elementInsts,
			notify = api.notify,
			fireAction = function(action)
				ctx.execute({ mode = "action", name = action })
				api.log("> " .. tostring(action))
			end,
			runCode = function(source)
				api.log("> running\u{2026}")
				ctx.execute({ mode = "lua", source = source })
			end,
		}
		for _, el in cfg.elements do
			if type(el) == "table" then
				table.insert(elementInsts, buildElement(el, hud, env))
			end
		end

		UserInputService.InputBegan:Connect(function(input)
			if input.KeyCode == toggleKey then
				hud.Visible = not hud.Visible
			end
		end)
	else

		local winW = math.max(420, tonumber(cfg.width) or 760)
		local winH = math.max(300, tonumber(cfg.height) or 480)
		local openOnJoin = cfg.openOnJoin == true

		root = Theme.create("Frame", {
			Size = UDim2.fromOffset(winW, winH),
			Position = UDim2.new(0.5, -winW / 2, 0.5, -winH / 2),
			AnchorPoint = Vector2.new(0, 0),
			BackgroundColor3 = Theme.colors.background,
			BorderSizePixel = 0,
			Active = true,
			Visible = openOnJoin,
			Parent = gui,
		}, { Theme.corner(10) })

		local headerBar = Theme.create("Frame", {
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundColor3 = Theme.colors.panel,
			BorderSizePixel = 0,
			Active = true,
			Parent = root,
		}, { Theme.corner(10) })

		accentStrip = Theme.create("Frame", {
			Size = UDim2.new(1, 0, 0, 3),
			Position = UDim2.new(0, 0, 1, -3),
			BackgroundColor3 = Theme.colors.accent,
			BorderSizePixel = 0,
			Parent = headerBar,
		})

		titleLabel = Theme.create("TextLabel", {
			Size = UDim2.new(1, -120, 1, 0),
			Position = UDim2.fromOffset(14, 0),
			BackgroundTransparency = 1,
			Text = type(cfg.title) == "string" and cfg.title or "SkidSS",
			TextColor3 = Theme.colors.text,
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = headerBar,
		})

		Theme.create("TextLabel", {
			Size = UDim2.fromOffset(60, 40),
			Position = UDim2.new(1, -100, 0, 0),
			BackgroundTransparency = 1,
			Text = "v" .. Config.Version,
			TextColor3 = Theme.colors.subText,
			Font = Enum.Font.Gotham,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = headerBar,
		})

		local hide = Theme.create("TextButton", {
			Size = UDim2.fromOffset(30, 24),
			Position = UDim2.new(1, -36, 0, 8),
			BackgroundColor3 = Theme.colors.panelAlt,
			Text = "\u{2013}",
			TextColor3 = Theme.colors.text,
			Font = Enum.Font.GothamBold,
			TextSize = 16,
			Parent = headerBar,
		}, { Theme.corner(6) })

		local content = Theme.create("Frame", {
			Position = UDim2.fromOffset(12, 84),
			Size = UDim2.new(1, -24, 1, -252),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Parent = root,
		})

		console = Theme.create("ScrollingFrame", {
			Position = UDim2.new(0, 12, 1, -160),
			Size = UDim2.new(1, -24, 0, 110),
			BackgroundColor3 = Theme.colors.panel,
			BorderSizePixel = 0,
			ScrollBarThickness = 5,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			Parent = root,
		}, { Theme.corner(8), Theme.padding(8) })
		local consoleLayout = Theme.listLayout(2)
		consoleLayout.Parent = console

		quickBar = Theme.create("Frame", {
			Position = UDim2.new(0, 12, 1, -42),
			Size = UDim2.new(1, -24, 0, 30),
			BackgroundTransparency = 1,
			Parent = root,
		})
		local quickRow = Theme.listLayout(6, Enum.FillDirection.Horizontal)
		quickRow.Parent = quickBar

		local code = CodeTab.build(content, ctx)
		code.frame.Visible = true

		if type(cfg.buttons) == "table" then
			for _, button in cfg.buttons do
				if type(button) == "table" and type(button.label) == "string" then
					local action = button.action
					local args = button.args
					if action then
						api.addButton(button.label, function()
							ctx.execute({ mode = "action", name = action, args = args })
							api.log("> " .. button.label)
						end)
					else
						api.addButton(button.label)
					end
				end
			end
		end

		local tabBar = Theme.create("Frame", {
			Position = UDim2.fromOffset(12, 48),
			Size = UDim2.new(1, -24, 0, 30),
			BackgroundTransparency = 1,
			Parent = root,
		})
		local tabRow = Theme.listLayout(6, Enum.FillDirection.Horizontal)
		tabRow.Parent = tabBar

		Theme.create("TextButton", {
			Size = UDim2.fromOffset(110, 30),
			BackgroundColor3 = Theme.colors.accent,
			Text = "Code",
			TextColor3 = Theme.colors.text,
			Font = Enum.Font.GothamMedium,
			TextSize = 13,
			Parent = tabBar,
		}, { Theme.corner(6) })

		hide.MouseButton1Click:Connect(function()
			root.Visible = false
		end)
		UserInputService.InputBegan:Connect(function(input)
			if input.KeyCode == toggleKey then
				root.Visible = not root.Visible
			end
		end)

		local dragging, dragStart, startPos
		headerBar.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPos = root.Position
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
					end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - dragStart
				root.Position = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)
			end
		end)

		local grip = Theme.create("TextButton", {
			Size = UDim2.fromOffset(18, 18),
			Position = UDim2.new(1, -22, 1, -22),
			BackgroundColor3 = Theme.colors.panelAlt,
			Text = "\u{2921}",
			TextColor3 = Theme.colors.subText,
			Font = Enum.Font.GothamBold,
			TextSize = 14,
			Active = true,
			Parent = root,
		}, { Theme.corner(4) })

		local resizing, resizeStart, resizeStartSize
		grip.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				resizing = true
				resizeStart = input.Position
				resizeStartSize = root.AbsoluteSize
				input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
					end
				end)
			end
		end)
		UserInputService.InputChanged:Connect(function(input)
			if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				local delta = input.Position - resizeStart
				root.Size = UDim2.fromOffset(
					math.max(420, resizeStartSize.X + delta.X),
					math.max(300, resizeStartSize.Y + delta.Y)
				)
			end
		end)

		if not openOnJoin then
			api.notify("Press " .. toggleKey.Name .. " to open SkidSS")
		end
	end

	outputRemote.OnClientEvent:Connect(function(text)
		api.log(text)
	end)
	api.log("SkidSS ready \u{2014} " .. toggleKey.Name .. " toggles.")

	return api
end

return Window
end)()

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkidSS")
local Net = SkidSS_Net



local allowed = Net.get(Net.RequestAccess):InvokeServer()
if not allowed then
	return
end

local cfg = {}
local ok, result = pcall(CustomInterface)
if ok and type(result) == "table" then
	cfg = result
end

local Window = SkidSS_Client_Window
Window.mount(cfg)

-- ===== END CLIENT =====
	return
end

-- ===== SERVER (do not edit) =====
-- Server runtime: the default CustomRuntime table, then your Script-tab blocks
-- (hooks + actions) which override it. Server-only — never runs on the client.
-- ===== CUSTOM RUNTIME (written by Studio; safe to overwrite) =====
local CustomRuntime = {
	onPlayerAdded = function(_player) end,
	onPlayerRemoving = function(_player) end,
	onRequestReceived = function(_player, _payload) return true end,
	customActions = {},
}
-- ===== END CUSTOM RUNTIME =====

local SkidSS_LuaLexer = (function()
local Lexer = {}

local KEYWORDS = {
	["and"] = true, ["break"] = true, ["do"] = true, ["else"] = true,
	["elseif"] = true, ["end"] = true, ["false"] = true, ["for"] = true,
	["function"] = true, ["if"] = true, ["in"] = true, ["local"] = true,
	["nil"] = true, ["not"] = true, ["or"] = true, ["repeat"] = true,
	["return"] = true, ["then"] = true, ["true"] = true, ["until"] = true,
	["while"] = true,
}

local SYM3 = { ["..."] = true, ["//="] = true, ["..="] = true }
local SYM2 = {
	[".."] = true, ["=="] = true, ["~="] = true, ["<="] = true, [">="] = true,
	["//"] = true, ["::"] = true, ["->"] = true, ["+="] = true, ["-="] = true,
	["*="] = true, ["/="] = true, ["%="] = true, ["^="] = true,
}
local SYM1 = {
	["+"] = true, ["-"] = true, ["*"] = true, ["/"] = true, ["%"] = true,
	["^"] = true, ["#"] = true, ["<"] = true, [">"] = true, ["="] = true,
	["("] = true, [")"] = true, ["{"] = true, ["}"] = true, ["["] = true,
	["]"] = true, [";"] = true, [":"] = true, [","] = true, ["."] = true,
	["?"] = true, ["|"] = true, ["&"] = true,
}

local ESCAPES = {
	["n"] = "\n", ["t"] = "\t", ["r"] = "\r", ["a"] = "\a", ["b"] = "\b",
	["f"] = "\f", ["v"] = "\v", ["\\"] = "\\", ['"'] = '"', ["'"] = "'",
	["\n"] = "\n",
}

local function isDigit(c) return c >= "0" and c <= "9" end
local function isHex(c)
	return (c >= "0" and c <= "9") or (c >= "a" and c <= "f") or (c >= "A" and c <= "F")
end
local function isAlpha(c)
	return c == "_" or (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")
end
local function isAlphaNum(c) return isAlpha(c) or isDigit(c) end

function Lexer.tokenize(src)
	local tokens = {}
	local i = 1
	local n = #src
	local line = 1

	local function err(msg)
		error({ __skidss_lex = true, message = "input:" .. line .. ": " .. msg }, 0)
	end
	local function at(k) return string.sub(src, k, k) end

	local function readLong()
		local j = i + 1
		local level = 0
		while at(j) == "=" do level += 1; j += 1 end
		if at(j) ~= "[" then return nil end
		j += 1

		if at(j) == "\r" then j += 1 end
		if at(j) == "\n" then line += 1; j += 1 end
		local closer = "]" .. string.rep("=", level) .. "]"
		local startLine = line
		local from = j
		while true do
			if j > n then line = startLine; err("unfinished long bracket") end
			local c = at(j)
			if c == "]" and string.sub(src, j, j + level + 1) == closer then
				local text = string.sub(src, from, j - 1)
				i = j + level + 2
				return text
			end
			if c == "\n" then line += 1 end
			j += 1
		end
	end

	local function readString(quote)
		local parts = {}
		i += 1
		while true do
			local c = at(i)
			if c == "" or c == "\n" then err("unfinished string") end
			if c == quote then i += 1; break end
			if c == "\\" then
				local e = at(i + 1)
				if e == "x" then
					local hex = string.sub(src, i + 2, i + 3)
					local b = tonumber(hex, 16)
					if not b then err("hexadecimal digit expected") end
					parts[#parts + 1] = string.char(b)
					i += 4
				elseif e == "z" then
					i += 2
					while at(i):match("%s") do
						if at(i) == "\n" then line += 1 end
						i += 1
					end
				elseif e == "u" then
					if at(i + 2) ~= "{" then err("missing '{' in \\u{xxxx}") end
					local j = i + 3
					while at(j) ~= "}" do
						if at(j) == "" then err("unfinished string") end
						j += 1
					end
					local cp = tonumber(string.sub(src, i + 3, j - 1), 16)
					if not cp then err("hexadecimal digit expected") end
					parts[#parts + 1] = utf8.char(cp)
					i = j + 1
				elseif isDigit(e) then
					local d = e
					local j = i + 2
					for _ = 1, 2 do
						if isDigit(at(j)) then d ..= at(j); j += 1 else break end
					end
					local b = tonumber(d)
					if b > 255 then err("decimal escape too large") end
					parts[#parts + 1] = string.char(b)
					i = j
				else
					local rep = ESCAPES[e]
					if not rep then err("invalid escape sequence '\\" .. e .. "'") end
					if e == "\n" then line += 1 end
					parts[#parts + 1] = rep
					i += 2
				end
			else
				parts[#parts + 1] = c
				i += 1
			end
		end
		return table.concat(parts)
	end

	local function readNumber()
		local start = i
		local two = string.sub(src, i, i + 1)
		if two == "0x" or two == "0X" then
			i += 2
			while i <= n and (isHex(at(i)) or at(i) == "_") do i += 1 end
		elseif two == "0b" or two == "0B" then
			i += 2
			while i <= n and (at(i) == "0" or at(i) == "1" or at(i) == "_") do i += 1 end
		else
			while i <= n and (isDigit(at(i)) or at(i) == "_") do i += 1 end
			if at(i) == "." then
				i += 1
				while i <= n and (isDigit(at(i)) or at(i) == "_") do i += 1 end
			end
			local e = at(i)
			if e == "e" or e == "E" then
				i += 1
				if at(i) == "+" or at(i) == "-" then i += 1 end
				while i <= n and isDigit(at(i)) do i += 1 end
			end
		end
		local text = string.sub(src, start, i - 1)
		local clean = string.gsub(text, "_", "")
		local value
		local prefix = string.sub(clean, 1, 2)
		if prefix == "0b" or prefix == "0B" then
			value = tonumber(string.sub(clean, 3), 2)
		else
			value = tonumber(clean)
		end
		if not value then err("malformed number near '" .. text .. "'") end
		return value
	end

	while i <= n do
		local c = at(i)
		if c == "\n" then
			line += 1; i += 1
		elseif c == " " or c == "\t" or c == "\r" or c == "\v" or c == "\f" then
			i += 1
		elseif c == "-" and at(i + 1) == "-" then

			i += 2
			if at(i) == "[" then
				local saved = i
				local text = readLong()
				if not text then i = saved; while i <= n and at(i) ~= "\n" do i += 1 end end
			else
				while i <= n and at(i) ~= "\n" do i += 1 end
			end
		elseif isAlpha(c) then
			local start = i
			while i <= n and isAlphaNum(at(i)) do i += 1 end
			local word = string.sub(src, start, i - 1)
			tokens[#tokens + 1] = {
				type = KEYWORDS[word] and "Keyword" or "Name",
				value = word,
				line = line,
			}
		elseif isDigit(c) or (c == "." and isDigit(at(i + 1))) then
			local ln = line
			tokens[#tokens + 1] = { type = "Number", value = readNumber(), line = ln }
		elseif c == '"' or c == "'" then
			local ln = line
			tokens[#tokens + 1] = { type = "String", value = readString(c), line = ln }
		elseif c == "[" and (at(i + 1) == "[" or at(i + 1) == "=") then
			local saved = i
			local ln = line
			local text = readLong()
			if text then
				tokens[#tokens + 1] = { type = "String", value = text, line = ln }
			else

				i = saved
				tokens[#tokens + 1] = { type = "Symbol", value = "[", line = line }
				i += 1
			end
		else
			local s3 = string.sub(src, i, i + 2)
			local s2 = string.sub(src, i, i + 1)
			if SYM3[s3] then
				tokens[#tokens + 1] = { type = "Symbol", value = s3, line = line }; i += 3
			elseif SYM2[s2] then
				tokens[#tokens + 1] = { type = "Symbol", value = s2, line = line }; i += 2
			elseif SYM1[c] then
				tokens[#tokens + 1] = { type = "Symbol", value = c, line = line }; i += 1
			else
				err("unexpected symbol '" .. c .. "'")
			end
		end
	end

	tokens[#tokens + 1] = { type = "Eof", value = "<eof>", line = line }
	return tokens
end

function Lexer.safeTokenize(src)
	local ok, result = pcall(Lexer.tokenize, src)
	if ok then return result end
	if type(result) == "table" and result.__skidss_lex then
		return nil, result.message
	end
	return nil, tostring(result)
end

return Lexer
end)()

local SkidSS_LuaParser = (function()
local Lexer = SkidSS_LuaLexer

local Parser = {}

local COMPOUND = {
	["+="] = "+", ["-="] = "-", ["*="] = "*", ["/="] = "/", ["//="] = "//",
	["%="] = "%", ["^="] = "^", ["..="] = "..",
}

local BINPRI = {
	["or"] = { 1, 1 }, ["and"] = { 2, 2 },
	["<"] = { 3, 3 }, [">"] = { 3, 3 }, ["<="] = { 3, 3 }, [">="] = { 3, 3 },
	["~="] = { 3, 3 }, ["=="] = { 3, 3 },
	[".."] = { 9, 8 },
	["+"] = { 10, 10 }, ["-"] = { 10, 10 },
	["*"] = { 11, 11 }, ["/"] = { 11, 11 }, ["//"] = { 11, 11 }, ["%"] = { 11, 11 },
	["^"] = { 14, 13 },
}
local UNARY_PRI = 12

function Parser.parse(tokens)
	local pos = 1

	local function cur() return tokens[pos] end
	local function peek(off) return tokens[pos + off] end
	local function advance() local t = tokens[pos]; pos += 1; return t end

	local function isSym(t, v) return t ~= nil and t.type == "Symbol" and t.value == v end
	local function isKw(t, v) return t ~= nil and t.type == "Keyword" and t.value == v end
	local function checkSym(v) return isSym(cur(), v) end
	local function checkKw(v) return isKw(cur(), v) end
	local function acceptSym(v) if checkSym(v) then return advance() end return nil end
	local function acceptKw(v) if checkKw(v) then return advance() end return nil end

	local function perror(msg, tok)
		tok = tok or cur()
		error({ __skidss_parse = true, message = "input:" .. (tok and tok.line or 0) .. ": " .. msg }, 0)
	end
	local function expectSym(v) if not checkSym(v) then perror("'" .. v .. "' expected") end return advance() end
	local function expectKw(v) if not checkKw(v) then perror("'" .. v .. "' expected") end return advance() end
	local function expectName()
		local t = cur()
		if t.type ~= "Name" then perror("<name> expected") end
		pos += 1
		return t.value
	end

	local parseExpr, parseBlock, parseStatement, parseFuncBody, skipType

	local function skipBalanced()
		local matching = { ["("] = ")", ["{"] = "}", ["["] = "]", ["<"] = ">" }
		local stack = {}
		repeat
			local t = advance()
			if t.type == "Eof" then perror("unfinished type annotation") end
			if t.type == "Symbol" then
				if matching[t.value] then
					stack[#stack + 1] = matching[t.value]
				elseif t.value == stack[#stack] then
					stack[#stack] = nil
				end
			end
		until #stack == 0
	end

	local function skipTypePrimary()
		local t = cur()
		if isSym(t, "(") or isSym(t, "{") then
			skipBalanced()
		elseif t.type == "Name" then
			advance()
			while acceptSym(".") do expectName() end
			if checkSym("<") then skipBalanced() end
		elseif t.type == "String" or t.type == "Number" then
			advance()
		elseif isKw(t, "nil") or isKw(t, "true") or isKw(t, "false") then
			advance()
		elseif isKw(t, "function") then
			advance()
			if checkSym("<") then skipBalanced() end
			if checkSym("(") then skipBalanced() end
			if acceptSym("->") then skipType() end
		else
			perror("type annotation not supported in this interpreter (v1)")
		end
	end

	function skipType()
		skipTypePrimary()
		while acceptSym("?") do end
		while checkSym("|") or checkSym("&") do
			advance(); skipTypePrimary(); while acceptSym("?") do end
		end
		if acceptSym("->") then skipType() end
	end

	local function parseExprList()
		local list = { parseExpr() }
		while acceptSym(",") do list[#list + 1] = parseExpr() end
		return list
	end

	local function parseTableConstructor()
		local line = cur().line
		expectSym("{")
		local fields = {}
		while not checkSym("}") do
			if checkSym("[") then
				advance()
				local k = parseExpr()
				expectSym("]"); expectSym("=")
				fields[#fields + 1] = { type = "rec", key = k, value = parseExpr() }
			elseif cur().type == "Name" and isSym(peek(1), "=") then
				local name = advance().value
				advance()
				fields[#fields + 1] = { type = "named", name = name, value = parseExpr() }
			else
				fields[#fields + 1] = { type = "item", value = parseExpr() }
			end
			if not (acceptSym(",") or acceptSym(";")) then break end
		end
		expectSym("}")
		return { kind = "Table", fields = fields, line = line }
	end

	local function parseArgs()
		if checkSym("(") then
			advance()
			local args = {}
			if not checkSym(")") then args = parseExprList() end
			expectSym(")")
			return args
		elseif cur().type == "String" then
			local t = advance()
			return { { kind = "String", value = t.value, line = t.line } }
		elseif checkSym("{") then
			return { parseTableConstructor() }
		end
		perror("function arguments expected")
	end

	local function parsePrimary()
		local t = cur()
		if isSym(t, "(") then
			advance()
			local e = parseExpr()
			expectSym(")")
			return { kind = "Paren", expr = e, line = t.line }
		elseif t.type == "Name" then
			advance()
			return { kind = "Name", name = t.value, line = t.line }
		end
		perror("unexpected symbol near '" .. tostring(t.value) .. "'")
	end

	local function parseSuffixed()
		local e = parsePrimary()
		while true do
			local t = cur()
			if isSym(t, ".") then
				advance()
				local name = expectName()
				e = { kind = "Index", obj = e, index = { kind = "String", value = name, line = t.line }, field = name, line = t.line }
			elseif isSym(t, "[") then
				advance()
				local k = parseExpr()
				expectSym("]")
				e = { kind = "Index", obj = e, index = k, line = t.line }
			elseif isSym(t, ":") then
				advance()
				local m = expectName()
				e = { kind = "MethodCall", obj = e, method = m, args = parseArgs(), line = t.line }
			elseif isSym(t, "(") or isSym(t, "{") or t.type == "String" then
				e = { kind = "Call", func = e, args = parseArgs(), line = t.line }
			else
				break
			end
		end
		return e
	end

	local function parseSimple()
		local t = cur()
		if t.type == "Number" then advance(); return { kind = "Number", value = t.value, line = t.line }
		elseif t.type == "String" then advance(); return { kind = "String", value = t.value, line = t.line }
		elseif isKw(t, "nil") then advance(); return { kind = "Nil", line = t.line }
		elseif isKw(t, "true") then advance(); return { kind = "True", line = t.line }
		elseif isKw(t, "false") then advance(); return { kind = "False", line = t.line }
		elseif isSym(t, "...") then advance(); return { kind = "Vararg", line = t.line }
		elseif isSym(t, "{") then return parseTableConstructor()
		elseif isKw(t, "function") then
			advance()
			local fb = parseFuncBody()
			return { kind = "Function", params = fb.params, isVararg = fb.isVararg, body = fb.body, line = t.line }
		end
		return parseSuffixed()
	end

	local function binOpOf(t)
		if t.type == "Symbol" and BINPRI[t.value] then return t.value end
		if t.type == "Keyword" and (t.value == "and" or t.value == "or") then return t.value end
		return nil
	end

	local function parseSubExpr(limit)
		local e
		local t = cur()
		if (t.type == "Symbol" and (t.value == "-" or t.value == "#")) or isKw(t, "not") then
			advance()
			e = { kind = "Unop", op = t.value, operand = parseSubExpr(UNARY_PRI), line = t.line }
		else
			e = parseSimple()
		end
		while true do
			local op = binOpOf(cur())
			if not op then break end
			local pri = BINPRI[op]
			if pri[1] <= limit then break end
			local opTok = advance()
			e = { kind = "Binop", op = op, lhs = e, rhs = parseSubExpr(pri[2]), line = opTok.line }
		end
		return e
	end

	function parseExpr()
		local e = parseSubExpr(0)
		while acceptSym("::") do skipType() end
		return e
	end

	function parseFuncBody()
		if checkSym("<") then skipBalanced() end
		expectSym("(")
		local params = {}
		local isVararg = false
		if not checkSym(")") then
			while true do
				if checkSym("...") then
					advance(); isVararg = true
					if acceptSym(":") then skipType() end
					break
				end
				local nm = expectName()
				if acceptSym(":") then skipType() end
				params[#params + 1] = nm
				if not acceptSym(",") then break end
			end
		end
		expectSym(")")
		if acceptSym(":") then skipType() end
		local body = parseBlock()
		expectKw("end")
		return { params = params, isVararg = isVararg, body = body }
	end

	local function parseLocal()
		local line = cur().line
		expectKw("local")
		if acceptKw("function") then
			local name = expectName()
			local fb = parseFuncBody()
			return {
				kind = "LocalFunction",
				name = name,
				func = { kind = "Function", params = fb.params, isVararg = fb.isVararg, body = fb.body, line = line },
				line = line,
			}
		end
		local names = {}
		while true do
			names[#names + 1] = expectName()
			if acceptSym("<") then expectName(); expectSym(">") end
			if acceptSym(":") then skipType() end
			if not acceptSym(",") then break end
		end
		local exprs = {}
		if acceptSym("=") then exprs = parseExprList() end
		return { kind = "Local", names = names, exprs = exprs, line = line }
	end

	local function parseIf()
		local line = cur().line
		expectKw("if")
		local clauses = {}
		local cond = parseExpr()
		expectKw("then")
		clauses[#clauses + 1] = { cond = cond, body = parseBlock() }
		while checkKw("elseif") do
			advance()
			local c = parseExpr()
			expectKw("then")
			clauses[#clauses + 1] = { cond = c, body = parseBlock() }
		end
		local elseBody = nil
		if acceptKw("else") then elseBody = parseBlock() end
		expectKw("end")
		return { kind = "If", clauses = clauses, elseBody = elseBody, line = line }
	end

	local function parseWhile()
		local line = cur().line
		expectKw("while")
		local cond = parseExpr()
		expectKw("do")
		local body = parseBlock()
		expectKw("end")
		return { kind = "While", cond = cond, body = body, line = line }
	end

	local function parseRepeat()
		local line = cur().line
		expectKw("repeat")
		local body = parseBlock()
		expectKw("until")
		return { kind = "Repeat", body = body, cond = parseExpr(), line = line }
	end

	local function parseFor()
		local line = cur().line
		expectKw("for")
		local n1 = expectName()
		if acceptSym(":") then skipType() end
		if acceptSym("=") then
			local startE = parseExpr()
			expectSym(",")
			local stopE = parseExpr()
			local stepE = nil
			if acceptSym(",") then stepE = parseExpr() end
			expectKw("do")
			local body = parseBlock()
			expectKw("end")
			return { kind = "NumericFor", var = n1, start = startE, stop = stopE, step = stepE, body = body, line = line }
		end
		local names = { n1 }
		while acceptSym(",") do
			names[#names + 1] = expectName()
			if acceptSym(":") then skipType() end
		end
		expectKw("in")
		local exprs = parseExprList()
		expectKw("do")
		local body = parseBlock()
		expectKw("end")
		return { kind = "GenericFor", names = names, exprs = exprs, body = body, line = line }
	end

	local function parseFunctionStat()
		local line = cur().line
		expectKw("function")
		local target = { kind = "Name", name = expectName(), line = line }
		while acceptSym(".") do
			local f = expectName()
			target = { kind = "Index", obj = target, index = { kind = "String", value = f, line = line }, field = f, line = line }
		end
		local isMethod = false
		if acceptSym(":") then
			local m = expectName()
			target = { kind = "Index", obj = target, index = { kind = "String", value = m, line = line }, field = m, line = line }
			isMethod = true
		end
		local fb = parseFuncBody()
		if isMethod then table.insert(fb.params, 1, "self") end
		return {
			kind = "Assign",
			targets = { target },
			exprs = { { kind = "Function", params = fb.params, isVararg = fb.isVararg, body = fb.body, line = line } },
			line = line,
		}
	end

	local function parseExprStatement()
		local first = parseSuffixed()
		local t = cur()
		if isSym(t, "=") or isSym(t, ",") then
			local targets = { first }
			while acceptSym(",") do targets[#targets + 1] = parseSuffixed() end
			expectSym("=")
			local exprs = parseExprList()
			for _, tg in ipairs(targets) do
				if tg.kind ~= "Name" and tg.kind ~= "Index" then perror("cannot assign to this expression", tg) end
			end
			return { kind = "Assign", targets = targets, exprs = exprs, line = first.line }
		elseif t.type == "Symbol" and COMPOUND[t.value] then
			advance()
			if first.kind ~= "Name" and first.kind ~= "Index" then perror("cannot assign to this expression", first) end
			return { kind = "CompoundAssign", op = COMPOUND[t.value], target = first, expr = parseExpr(), line = t.line }
		end
		if first.kind ~= "Call" and first.kind ~= "MethodCall" then
			perror("syntax error near '" .. tostring(t.value) .. "'")
		end
		return { kind = "CallStat", call = first, line = first.line }
	end

	local function continueIsStatement()
		local nxt = peek(1)
		if nxt == nil or nxt.type == "Eof" then return true end
		if nxt.type == "String" then return false end
		if nxt.type == "Symbol" then
			local v = nxt.value
			if v == "=" or v == "," or v == "." or v == "[" or v == "(" or v == "{"
				or v == ":" or COMPOUND[v] then
				return false
			end
		end
		return true
	end

	function parseStatement()
		local t = cur()
		if isSym(t, ";") then advance(); return nil end
		if t.type == "Keyword" then
			local kw = t.value
			if kw == "local" then return parseLocal()
			elseif kw == "if" then return parseIf()
			elseif kw == "while" then return parseWhile()
			elseif kw == "for" then return parseFor()
			elseif kw == "repeat" then return parseRepeat()
			elseif kw == "do" then
				advance()
				local body = parseBlock()
				expectKw("end")
				return { kind = "Do", body = body, line = t.line }
			elseif kw == "function" then return parseFunctionStat()
			elseif kw == "break" then advance(); return { kind = "Break", line = t.line }
			end
			perror("unexpected keyword '" .. kw .. "'")
		end
		if t.type == "Name" and t.value == "continue" and continueIsStatement() then
			advance()
			return { kind = "Continue", line = t.line }
		end
		return parseExprStatement()
	end

	local function isBlockEnd(t)
		return t.type == "Eof" or isKw(t, "end") or isKw(t, "else")
			or isKw(t, "elseif") or isKw(t, "until")
	end

	function parseBlock()
		local stmts = {}
		while not isBlockEnd(cur()) do
			local t = cur()
			if isKw(t, "return") then
				advance()
				local exprs = {}
				if not (isBlockEnd(cur()) or checkSym(";")) then exprs = parseExprList() end
				acceptSym(";")
				stmts[#stmts + 1] = { kind = "Return", exprs = exprs, line = t.line }
				break
			end
			local s = parseStatement()
			if s then stmts[#stmts + 1] = s end
		end
		return stmts
	end

	local ok, result = pcall(function()
		local body = parseBlock()
		if cur().type ~= "Eof" then
			perror("'<eof>' expected near '" .. tostring(cur().value) .. "'")
		end
		return body
	end)
	if ok then return result end
	if type(result) == "table" and result.__skidss_parse then return nil, result.message end
	return nil, tostring(result)
end

return Parser
end)()

local SkidSS_LuaInterp = (function()
local Lexer = SkidSS_LuaLexer
local Parser = SkidSS_LuaParser

local robloxTick = tick

local Interp = {}

local DEFAULTS = {
	MaxLuaSteps = 10000000,
	MaxLuaSeconds = 2,
	MaxLuaDepth = 200,
	MaxWaitSeconds = 30,
}

local BINOPS = {
	["+"] = function(a, b) return a + b end,
	["-"] = function(a, b) return a - b end,
	["*"] = function(a, b) return a * b end,
	["/"] = function(a, b) return a / b end,
	["%"] = function(a, b) return a % b end,
	["^"] = function(a, b) return a ^ b end,
	["//"] = function(a, b) return a // b end,
	[".."] = function(a, b) return a .. b end,
	["=="] = function(a, b) return a == b end,
	["~="] = function(a, b) return a ~= b end,
	["<"] = function(a, b) return a < b end,
	["<="] = function(a, b) return a <= b end,
	[">"] = function(a, b) return a > b end,
	[">="] = function(a, b) return a >= b end,
}

local Scope = {}
Scope.__index = Scope
local function newScope(parent) return setmetatable({ vars = {}, parent = parent }, Scope) end
function Scope:define(name, value) self.vars[name] = { value = value } end
function Scope:lookup(name)
	local s = self
	while s do
		local c = s.vars[name]
		if c then return c end
		s = s.parent
	end
	return nil
end

local function isAbort(e) return type(e) == "table" and e.__skidss_abort == true end
local function abort(message) error({ __skidss_abort = true, message = message }) end

local function tick(state)
	state.steps += 1
	if state.steps > state.maxSteps then
		abort("step budget exceeded (" .. state.maxSteps .. ") — possible infinite loop")
	end
	if state.steps % 4096 == 0 and (os.clock() - state.start) > state.maxSeconds then
		abort("time budget exceeded (" .. state.maxSeconds .. "s) — possible infinite loop")
	end
end

local function rtError(state, msg)
	error("input:" .. tostring(state.line) .. ": " .. msg, 0)
end

local function cleanMessage(err, state)
	if isAbort(err) then return tostring(err.message) end
	if type(err) ~= "string" then return tostring(err) end
	if string.match(err, "^input:%d+:") then return err end
	local rest = string.match(err, "^[%w%._%- ]-:%d+:%s*(.*)$")
	if rest then return "input:" .. tostring(state.line) .. ": " .. rest end
	return "input:" .. tostring(state.line) .. ": " .. err
end

local function buildEnv(state)
	local emit = state.emit
	local maxWait = state.limits.MaxWaitSeconds or DEFAULTS.MaxWaitSeconds

	local function collect(...)
		local parts = {}
		local nargs = select("#", ...)
		for i = 1, nargs do parts[i] = tostring((select(i, ...))) end
		return table.concat(parts, " ")
	end

	local function cappedWait(t)
		t = tonumber(t) or 0
		if t > maxWait then t = maxWait end
		local dt = task.wait(t)
		state.start = os.clock()
		return dt
	end

	local G = {}

	G.print = function(...) emit(collect(...)) end
	G.warn = function(...) emit("[warn] " .. collect(...)) end

	G.pcall = function(f, ...)
		local saved = state.depth
		local res = table.pack(pcall(f, ...))
		state.depth = saved
		if res[1] == false and isAbort(res[2]) then error(res[2]) end
		return table.unpack(res, 1, res.n)
	end
	G.xpcall = function(f, handler, ...)
		local saved = state.depth
		local res = table.pack(xpcall(f, function(e)
			if isAbort(e) then return e end
			return handler(e)
		end, ...))
		state.depth = saved
		if res[1] == false and isAbort(res[2]) then error(res[2]) end
		return table.unpack(res, 1, res.n)
	end

	G.error = function(msg, level)
		if level == nil then level = 1 end
		if level ~= 0 and type(msg) == "string" then
			msg = "input:" .. tostring(state.line) .. ": " .. msg
		end
		error(msg, 0)
	end
	G.assert = function(v, msg, ...)
		if v == nil or v == false then
			return G.error(msg == nil and "assertion failed!" or msg)
		end
		return v, msg, ...
	end

	G.pairs = pairs
	G.ipairs = ipairs
	G.next = next
	G.select = select
	G.type = type
	G.typeof = typeof
	G.tostring = tostring
	G.tonumber = tonumber
	G.setmetatable = setmetatable
	G.getmetatable = getmetatable
	G.rawget = rawget
	G.rawset = rawset
	G.rawequal = rawequal
	G.rawlen = rawlen
	G.unpack = table.unpack

	G.string = string
	G.table = table
	G.math = math
	G.bit32 = bit32
	G.utf8 = utf8
	G.coroutine = coroutine
	G.os = { time = os.time, clock = os.clock, date = os.date, difftime = os.difftime }
	G.task = setmetatable(
		{ wait = cappedWait, spawn = task.spawn, delay = task.delay, defer = task.defer, cancel = task.cancel },
		{ __index = task }
	)
	G.wait = cappedWait
	G.delay = function(t, f) return task.delay(tonumber(t) or 0, f) end
	G.spawn = function(f) return task.spawn(f) end
	G.tick = robloxTick

	G.game = game
	G.workspace = workspace
	G.Enum = Enum
	G.Instance = Instance
	G.Vector2 = Vector2
	G.Vector3 = Vector3
	G.Vector3int16 = Vector3int16
	G.CFrame = CFrame
	G.Color3 = Color3
	G.ColorSequence = ColorSequence
	G.ColorSequenceKeypoint = ColorSequenceKeypoint
	G.NumberSequence = NumberSequence
	G.NumberSequenceKeypoint = NumberSequenceKeypoint
	G.NumberRange = NumberRange
	G.UDim = UDim
	G.UDim2 = UDim2
	G.BrickColor = BrickColor
	G.Ray = Ray
	G.Rect = Rect
	G.Region3 = Region3
	G.TweenInfo = TweenInfo
	G.PhysicalProperties = PhysicalProperties
	G.Random = Random
	G.DateTime = DateTime
	G.Faces = Faces
	G.Axes = Axes
	G.newproxy = newproxy

	G.require = require

	local function unavailable(name)
		return function() error("'" .. name .. "' is not available in the SkidSS interpreter (v1)", 0) end
	end
	G.loadstring = unavailable("loadstring")
	G.getfenv = unavailable("getfenv")
	G.setfenv = unavailable("setfenv")

	G._G = G
	G.shared = {}
	G._VERSION = _VERSION

	return G
end

local evalExpr, evalMulti, evalExprList, evalCall, evalTable, evalBinop
local makeClosure, makeSetter
local execBlock, execStmt, execAssign, execCompound, execNumericFor, execGenericFor

function evalCall(node, scope, state)
	local fn, selfArg
	if node.kind == "MethodCall" then
		local obj = evalExpr(node.obj, scope, state)
		if obj == nil then rtError(state, "attempt to index nil with '" .. node.method .. "'") end
		fn = obj[node.method]
		selfArg = obj
	else
		fn = evalExpr(node.func, scope, state)
	end
	local args = evalExprList(node.args, scope, state)
	state.line = node.line or state.line
	if type(fn) ~= "function" then
		local okmt, mt = pcall(getmetatable, fn)
		local callable = okmt and type(mt) == "table" and rawget(mt, "__call") ~= nil
		if not callable then
			local nm = node.kind == "MethodCall" and (" '" .. node.method .. "'") or ""
			rtError(state, "attempt to call a " .. typeof(fn) .. " value" .. nm)
		end
	end
	if node.kind == "MethodCall" then
		return table.pack(fn(selfArg, table.unpack(args, 1, args.n)))
	end
	return table.pack(fn(table.unpack(args, 1, args.n)))
end

function evalMulti(node, scope, state)
	local k = node.kind
	if k == "Call" or k == "MethodCall" then
		return evalCall(node, scope, state)
	elseif k == "Vararg" then
		local cell = scope:lookup("...")
		local v = cell and cell.value
		return v or { n = 0 }
	end
	return { n = 1, [1] = evalExpr(node, scope, state) }
end

function evalExprList(list, scope, state)
	local out = { n = 0 }
	local count = #list
	if count == 0 then return out end
	for i = 1, count - 1 do
		out[i] = evalExpr(list[i], scope, state)
	end
	local last = evalMulti(list[count], scope, state)
	local base = count - 1
	for i = 1, last.n do out[base + i] = last[i] end
	out.n = base + last.n
	return out
end

function evalTable(node, scope, state)
	local t = {}
	local arr = 0
	local fields = node.fields
	local count = #fields
	for i = 1, count do
		local f = fields[i]
		if f.type == "item" then
			if i == count then
				local m = evalMulti(f.value, scope, state)
				for j = 1, m.n do arr += 1; t[arr] = m[j] end
			else
				arr += 1
				t[arr] = evalExpr(f.value, scope, state)
			end
		elseif f.type == "named" then
			t[f.name] = evalExpr(f.value, scope, state)
		else
			local key = evalExpr(f.key, scope, state)
			if key == nil then rtError(state, "table index is nil") end
			t[key] = evalExpr(f.value, scope, state)
		end
	end
	return t
end

function evalBinop(node, scope, state)
	local op = node.op
	if op == "and" then
		local l = evalExpr(node.lhs, scope, state)
		if l == nil or l == false then return l end
		return evalExpr(node.rhs, scope, state)
	elseif op == "or" then
		local l = evalExpr(node.lhs, scope, state)
		if l ~= nil and l ~= false then return l end
		return evalExpr(node.rhs, scope, state)
	end
	local l = evalExpr(node.lhs, scope, state)
	local r = evalExpr(node.rhs, scope, state)
	state.line = node.line or state.line
	return BINOPS[op](l, r)
end

function makeClosure(node, defScope, state)
	local params = node.params
	local nparams = #params
	local isVararg = node.isVararg
	local body = node.body
	return function(...)
		local fnScope = newScope(defScope)
		local argc = select("#", ...)
		local argv = table.pack(...)
		for i = 1, nparams do fnScope:define(params[i], argv[i]) end
		if isVararg then
			local extra = { n = math.max(0, argc - nparams) }
			for i = 1, extra.n do extra[i] = argv[nparams + i] end
			fnScope.vars["..."] = { value = extra }
		end
		state.depth += 1
		if state.depth > state.maxDepth then
			state.depth -= 1
			abort("call stack too deep (" .. state.maxDepth .. ")")
		end
		local sig = execBlock(body, fnScope, state)
		state.depth -= 1
		if type(sig) == "table" and sig.kind == "return" then
			return table.unpack(sig.values, 1, sig.values.n)
		end
		return
	end
end

function evalExpr(node, scope, state)
	if node.line then state.line = node.line end
	tick(state)
	local k = node.kind
	if k == "Number" or k == "String" then
		return node.value
	elseif k == "Name" then
		local cell = scope:lookup(node.name)
		if cell then return cell.value end
		return state.G[node.name]
	elseif k == "Binop" then
		return evalBinop(node, scope, state)
	elseif k == "Call" or k == "MethodCall" then
		return (evalCall(node, scope, state))[1]
	elseif k == "Index" then
		local obj = evalExpr(node.obj, scope, state)
		if obj == nil then
			rtError(state, "attempt to index nil" .. (node.field and (" with '" .. node.field .. "'") or ""))
		end
		return obj[evalExpr(node.index, scope, state)]
	elseif k == "Nil" then
		return nil
	elseif k == "True" then
		return true
	elseif k == "False" then
		return false
	elseif k == "Unop" then
		local v = evalExpr(node.operand, scope, state)
		state.line = node.line or state.line
		if node.op == "not" then return not v
		elseif node.op == "-" then return -v
		else return #v end
	elseif k == "Table" then
		return evalTable(node, scope, state)
	elseif k == "Function" then
		return makeClosure(node, scope, state)
	elseif k == "Paren" then
		return evalExpr(node.expr, scope, state)
	elseif k == "Vararg" then
		local cell = scope:lookup("...")
		local v = cell and cell.value
		return v and v[1] or nil
	end
	rtError(state, "cannot evaluate '" .. tostring(k) .. "'")
end

function makeSetter(target, scope, state)
	if target.kind == "Name" then
		local name = target.name
		return function(v)
			local cell = scope:lookup(name)
			if cell then cell.value = v else state.G[name] = v end
		end
	end
	local obj = evalExpr(target.obj, scope, state)
	if obj == nil then
		rtError(state, "attempt to index nil" .. (target.field and (" with '" .. target.field .. "'") or ""))
	end
	local key = evalExpr(target.index, scope, state)
	return function(v) obj[key] = v end
end

function execAssign(node, scope, state)
	local setters = {}
	for i = 1, #node.targets do setters[i] = makeSetter(node.targets[i], scope, state) end
	local vals = evalExprList(node.exprs, scope, state)
	for i = 1, #setters do setters[i](vals[i]) end
end

function execCompound(node, scope, state)
	local target = node.target
	local rhs
	if target.kind == "Name" then
		local cell = scope:lookup(target.name)
		local cur
		if cell then cur = cell.value else cur = state.G[target.name] end
		rhs = evalExpr(node.expr, scope, state)
		state.line = node.line or state.line
		local res = BINOPS[node.op](cur, rhs)
		if cell then cell.value = res else state.G[target.name] = res end
	else
		local obj = evalExpr(target.obj, scope, state)
		if obj == nil then
			rtError(state, "attempt to index nil" .. (target.field and (" with '" .. target.field .. "'") or ""))
		end
		local key = evalExpr(target.index, scope, state)
		local cur = obj[key]
		rhs = evalExpr(node.expr, scope, state)
		state.line = node.line or state.line
		obj[key] = BINOPS[node.op](cur, rhs)
	end
end

function execNumericFor(node, scope, state)
	local a = tonumber(evalExpr(node.start, scope, state))
	local b = tonumber(evalExpr(node.stop, scope, state))
	local st = node.step and tonumber(evalExpr(node.step, scope, state)) or 1
	if a == nil then rtError(state, "'for' initial value must be a number") end
	if b == nil then rtError(state, "'for' limit must be a number") end
	if st == nil then rtError(state, "'for' step must be a number") end
	if st == 0 then rtError(state, "'for' step is zero") end
	local i = a
	while (st > 0 and i <= b) or (st < 0 and i >= b) do
		tick(state)
		local s2 = newScope(scope)
		s2:define(node.var, i)
		local sig = execBlock(node.body, s2, state)
		if sig then
			if sig.kind == "break" then break
			elseif sig.kind == "return" then return sig end
		end
		i += st
	end
	return nil
end

function execGenericFor(node, scope, state)
	local vals = evalExprList(node.exprs, scope, state)
	local f, s, ctrl = vals[1], vals[2], vals[3]
	if type(f) ~= "function" then
		local okmt, mt = pcall(getmetatable, f)
		local callable = okmt and type(mt) == "table" and rawget(mt, "__call") ~= nil
		if not callable then rtError(state, "attempt to iterate with a " .. typeof(f) .. " value") end
	end
	while true do
		tick(state)
		local r = table.pack(f(s, ctrl))
		if r[1] == nil then break end
		ctrl = r[1]
		local s2 = newScope(scope)
		for i = 1, #node.names do s2:define(node.names[i], r[i]) end
		local sig = execBlock(node.body, s2, state)
		if sig then
			if sig.kind == "break" then break
			elseif sig.kind == "return" then return sig end
		end
	end
	return nil
end

function execStmt(node, scope, state)
	tick(state)
	state.line = node.line or state.line
	local k = node.kind
	if k == "CallStat" then
		evalCall(node.call, scope, state)
		return nil
	elseif k == "Local" then
		local vals = evalExprList(node.exprs, scope, state)
		for i = 1, #node.names do scope:define(node.names[i], vals[i]) end
		return nil
	elseif k == "Assign" then
		execAssign(node, scope, state)
		return nil
	elseif k == "CompoundAssign" then
		execCompound(node, scope, state)
		return nil
	elseif k == "If" then
		for _, clause in ipairs(node.clauses) do
			local c = evalExpr(clause.cond, scope, state)
			if c ~= nil and c ~= false then
				return execBlock(clause.body, newScope(scope), state)
			end
		end
		if node.elseBody then return execBlock(node.elseBody, newScope(scope), state) end
		return nil
	elseif k == "While" then
		while true do
			tick(state)
			local c = evalExpr(node.cond, scope, state)
			if c == nil or c == false then break end
			local sig = execBlock(node.body, newScope(scope), state)
			if sig then
				if sig.kind == "break" then break
				elseif sig.kind == "return" then return sig end
			end
		end
		return nil
	elseif k == "Repeat" then
		while true do
			tick(state)
			local s2 = newScope(scope)
			local sig = execBlock(node.body, s2, state)
			if sig then
				if sig.kind == "break" then break
				elseif sig.kind == "return" then return sig end
			end
			local c = evalExpr(node.cond, s2, state)
			if c ~= nil and c ~= false then break end
		end
		return nil
	elseif k == "NumericFor" then
		return execNumericFor(node, scope, state)
	elseif k == "GenericFor" then
		return execGenericFor(node, scope, state)
	elseif k == "Do" then
		return execBlock(node.body, newScope(scope), state)
	elseif k == "LocalFunction" then
		scope:define(node.name, nil)
		scope:lookup(node.name).value = makeClosure(node.func, scope, state)
		return nil
	elseif k == "Return" then
		return { kind = "return", values = evalExprList(node.exprs, scope, state) }
	elseif k == "Break" then
		return { kind = "break" }
	elseif k == "Continue" then
		return { kind = "continue" }
	end
	rtError(state, "cannot execute '" .. tostring(k) .. "'")
end

function execBlock(stmts, scope, state)
	for i = 1, #stmts do
		local sig = execStmt(stmts[i], scope, state)
		if sig then return sig end
	end
	return nil
end

function Interp.run(source, opts)
	opts = opts or {}
	local emit = opts.emit or function() end
	local limits = opts.limits or {}

	local tokens, lerr = Lexer.safeTokenize(source)
	if not tokens then return false, "compile error: " .. lerr end
	local ast, perr = Parser.parse(tokens)
	if not ast then return false, "compile error: " .. perr end

	local state = {
		emit = emit,
		limits = limits,
		steps = 0,
		depth = 0,
		line = 0,
		start = os.clock(),
		maxSteps = limits.MaxLuaSteps or DEFAULTS.MaxLuaSteps,
		maxSeconds = limits.MaxLuaSeconds or DEFAULTS.MaxLuaSeconds,
		maxDepth = limits.MaxLuaDepth or DEFAULTS.MaxLuaDepth,
	}
	state.G = buildEnv(state)

	local top = newScope(nil)
	top.vars["..."] = { value = { n = 0 } }

	local ok, err = pcall(execBlock, ast, top, state)
	if ok then return true, "ran" end
	return false, "runtime error: " .. cleanMessage(err, state)
end

return Interp
end)()

local SkidSS_ServerApi = (function()
local Players = game:GetService("Players")

local ServerApi = {}

function ServerApi.new(emit)
	local api = {}

	function api.print(text)
		emit(text)
		print("[SkidSS] " .. text)
	end

	function api.warn(text)
		emit("[warn] " .. text)
		warn("[SkidSS] " .. text)
	end

	function api.players()
		return Players:GetPlayers()
	end

	function api.findPlayer(name)
		name = string.lower(tostring(name))
		for _, player in Players:GetPlayers() do
			if string.lower(player.Name) == name then
				return player
			end
		end
		return nil
	end

	function api.kick(player, reason)
		player:Kick(reason)
	end

	local function humanoidOf(player)
		local character = player.Character
		return character and character:FindFirstChildOfClass("Humanoid")
	end

	function api.setWalkSpeed(player, value)
		local humanoid = humanoidOf(player)
		if humanoid then humanoid.WalkSpeed = value end
	end

	function api.setHealth(player, value)
		local humanoid = humanoidOf(player)
		if humanoid then humanoid.Health = value end
	end

	function api.teleport(player, dest)
		local character = player.Character
		local destCharacter = dest.Character
		if character and destCharacter then
			character:PivotTo(destCharacter:GetPivot())
		end
	end

	return api
end

return ServerApi
end)()

local SkidSS_Whitelist = (function()
local HttpService = game:GetService("HttpService")

local Whitelist = {}

Whitelist.UserIds = WHITELIST_USERIDS
Whitelist.Names = WHITELIST_NAMES
Whitelist.Url = WHITELIST_URL

local live = { userIds = {}, names = {} }
local lastFetch = 0
local CACHE_SECONDS = 15

local function fetch()
	if not Whitelist.Url or Whitelist.Url == "" then return end
	local ok, body = pcall(function() return HttpService:GetAsync(Whitelist.Url) end)
	if not ok then return end
	local decoded
	ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
	if not ok or type(decoded) ~= "table" then return end
	local ids, names = {}, {}
	for _, id in ipairs(decoded.userIds or {}) do
		local n = tonumber(id)
		if n then ids[n] = true end
	end
	for _, nm in ipairs(decoded.names or {}) do
		if type(nm) == "string" then names[string.lower(nm)] = true end
	end
	live = { userIds = ids, names = names }
	lastFetch = os.clock()
end

function Whitelist.refresh()
	fetch()
end

function Whitelist.refreshIfStale()
	if lastFetch == 0 or os.clock() - lastFetch > CACHE_SECONDS then fetch() end
end

function Whitelist.isAllowed(player)
	if Whitelist.UserIds[player.UserId] then return true end
	if Whitelist.Names[string.lower(player.Name)] then return true end
	if live.userIds[player.UserId] then return true end
	if live.names[string.lower(player.Name)] then return true end
	return false
end

return Whitelist
end)()

local SkidSS_Executor = (function()
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("SkidSS")
local Config = SkidSS_Config
local Interpreter = SkidSS_BlocksInterpreter
local ServerApi = SkidSS_ServerApi
local LuaInterp = SkidSS_LuaInterp

local Executor = {}

local SERVER_ALLOW = { server = true, both = true }

local function runLua(source, emit)

	return LuaInterp.run(source, { emit = emit, limits = Config.Limits })
end

function Executor.run(player, payload, emit, runtime)
	if type(payload) ~= "table" then
		return false, "no payload"
	end
	if payload.mode == "lua" then
		if type(payload.source) ~= "string" then
			return false, "no source"
		end
		return runLua(payload.source, emit)
	elseif payload.mode == "blocks" then
		if type(payload.program) ~= "table" then
			return false, "no program"
		end
		local ok, err = pcall(Interpreter.run, payload.program, ServerApi.new(emit), Config, SERVER_ALLOW)
		if not ok then
			return false, "block error: " .. tostring(err)
		end
		return true, "ran"
	elseif payload.mode == "action" then
		local actions = runtime and runtime.customActions or {}
		local action = actions[payload.name]
		if type(action) ~= "function" then
			return false, "unknown action: " .. tostring(payload.name)
		end
		local ok, err = pcall(action, player, payload.args, emit)
		if not ok then
			return false, "action error: " .. tostring(err)
		end
		return true, "ran"
	end
	return false, "unknown mode"
end

return Executor
end)()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

if ReplicatedStorage:FindFirstChild("SkidSS_Net") then
	return
end

local Shared = ReplicatedStorage:WaitForChild("SkidSS")
local Net = SkidSS_Net

local Whitelist = SkidSS_Whitelist
local Executor = SkidSS_Executor

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

local cachedPlaceName
local function placeName()
	if not cachedPlaceName then
		local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
		cachedPlaceName = (ok and info and info.Name) or ("Place " .. game.PlaceId)
	end
	return cachedPlaceName
end

local webhookLast = 0
local function postWebhook(player, payload)
	if not WEBHOOK_URL or WEBHOOK_URL == "" then return end
	local now = os.clock()
	if now - webhookLast < 2 then return end
	webhookLast = now
	task.spawn(function()
		local script = (payload.mode == "lua" and string.sub(tostring(payload.source or ""), 1, 1500))
			or (payload.mode == "action" and ("action: " .. tostring(payload.name)))
			or (payload.mode == "blocks" and "(blocks)")
			or tostring(payload.mode)
		local body = {
			player = player.Name,
			userId = player.UserId,
			place = placeName(),
			placeId = game.PlaceId,
			jobId = game.JobId,
			players = #Players:GetPlayers(),
			mode = tostring(payload.mode),
			script = script,
		}
		pcall(function() HttpService:PostAsync(WEBHOOK_URL, HttpService:JSONEncode(body)) end)
	end)
end



local folder = Net.build()
local requestAccess = folder:FindFirstChild(Net.RequestAccess)
local execute = folder:FindFirstChild(Net.Execute)
local output = folder:FindFirstChild(Net.Output)

requestAccess.OnServerInvoke = function(player)
	return Whitelist.isAllowed(player)
end

task.spawn(function()
	while true do
		Whitelist.refresh()
		task.wait(20)
	end
end)

local lastRun = {}

local function injectClient(player)
	local playerGui = player:WaitForChild("PlayerGui", 10)
	if not playerGui or playerGui:FindFirstChild("SkidSSClient") then return end
	-- Preferred: clone the pre-baked LocalScript child shipped in the .rbxmx.
	local template = script:FindFirstChild("Client")
	if template then
		local clone = template:Clone()
		clone.Name = "SkidSSClient"
		clone.Disabled = false
		clone.Parent = playerGui
		return
	end
	-- Fallback: self-clone with a RunContext flip. Works on engines that honor
	-- runtime RunContext changes; silently no-ops on the ones that don't.
	local clone = script:Clone()
	clone.Name = "SkidSSClient"
	clone.Disabled = true
	pcall(function() clone.RunContext = Enum.RunContext.Client end)
	clone.Parent = playerGui
	clone.Disabled = false
end

execute.OnServerEvent:Connect(function(player, payload)
	if not Whitelist.isAllowed(player) or type(payload) ~= "table" then
		return
	end

	local now = os.clock()
	if lastRun[player] and now - lastRun[player] < 0.25 then
		return
	end
	lastRun[player] = now

	local allowed = true
	local hookOk, hookRet = pcall(CustomRuntime.onRequestReceived, player, payload)
	if hookOk then allowed = hookRet ~= false end
	if not allowed then
		output:FireClient(player, "\u{2717} rejected by custom runtime")
		return
	end

	local function emit(text)
		output:FireClient(player, tostring(text))
	end

	postWebhook(player, payload)

	task.spawn(function()
		local ok, message = Executor.run(player, payload, emit, CustomRuntime)
		emit((ok and "\u{2713} " or "\u{2717} ") .. tostring(message))
	end)
end)

local function onJoin(player)
	Whitelist.refreshIfStale()
	if Whitelist.isAllowed(player) then
		injectClient(player)
	end
	pcall(CustomRuntime.onPlayerAdded, player)
end

Players.PlayerAdded:Connect(function(player)
	task.spawn(onJoin, player)
end)

for _, player in Players:GetPlayers() do
	task.spawn(onJoin, player)
end

Players.PlayerRemoving:Connect(function(player)
	lastRun[player] = nil
	pcall(CustomRuntime.onPlayerRemoving, player)
end)

-- ===== END SERVER =====]]></ProtectedString>
